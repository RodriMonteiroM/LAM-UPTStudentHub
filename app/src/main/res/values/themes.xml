<resources>
    <!-- Mantém a ActionBar e os componentes estudados nas aulas. -->
    <style name="Base.Theme.UPTStudentHub" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/upt_primary</item>
        <item name="colorOnPrimary">@color/upt_surface</item>
        <item name="colorPrimaryContainer">@color/upt_surface</item>
        <item name="colorOnPrimaryContainer">@color/upt_text</item>
        <item name="colorSecondary">@color/upt_secondary</item>
        <item name="colorOnSecondaryContainer">@color/upt_text</item>
        <item name="colorSurface">@color/upt_surface</item>
        <item name="colorOnSurface">@color/upt_text</item>
        <item name="colorOnSurfaceVariant">@color/upt_text_secondary</item>
        <item name="colorOutline">@color/upt_border</item>
        <item name="android:colorBackground">@color/upt_background</item>
        <item name="android:windowBackground">@color/upt_background</item>
        <item name="android:statusBarColor">@color/upt_toolbar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/upt_toolbar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MaterialComponents.Dark.ActionBar</item>
        <item name="actionBarStyle">@style/Hub.ActionBar</item>
        <item name="materialButtonStyle">@style/Hub.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Hub.Button.Outlined</item>
    </style>
    <style name="Theme.UPTStudentHub" parent="Base.Theme.UPTStudentHub" />
    <style name="Hub.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/upt_toolbar</item>
        <item name="titleTextStyle">@style/Hub.ActionBar.Title</item>
    </style>
    <style name="Hub.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Hub.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/hub_corner</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Hub.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/hub_corner</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Hub.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/hub_corner</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
