<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Semana 7: acesso Ã  Internet (permissÃ£o normal, dada automaticamente na instalaÃ§Ã£o) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Semana 7: necessÃ¡ria para consultar o estado da rede (ConnectivityManager) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Sem usesCleartextTraffic: sÃ³ usamos https, por isso nÃ£o Ã© preciso nenhuma exceÃ§Ã£o -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UPTStudentHub"
        tools:targetApi="31">

        <!-- singleTop: a seta Up reutiliza esta MainActivity, por isso o nome escrito nÃ£o se perde (FR11) -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- parentActivityName ativa a seta Up para a MainActivity -->
        <activity
            android:name=".activities.TimetableActivity"
            android:exported="false"
            android:label="@string/timetable_label"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Semana 7: ecrÃ£ da meteorologia, tambÃ©m filho da MainActivity (seta Up) -->
        <activity
            android:name=".activities.WeatherActivity"
            android:exported="false"
            android:label="@string/weather_label"
            android:parentActivityName=".activities.MainActivity" />
    <activity android:name=".activities.ExplorerActivity" android:exported="false" android:label="@string/ex_title" android:parentActivityName=".activities.MainActivity" />
<activity android:name=".activities.DetailActivity" android:exported="false" android:label="@string/ex_detail_title" android:parentActivityName=".activities.ExplorerActivity" />
<activity android:name=".activities.SettingsActivity" android:exported="false" android:label="@string/ex_settings_title" android:parentActivityName=".activities.ExplorerActivity" />
<activity android:name=".activities.CompareActivity" android:exported="false" android:label="@string/ex_compare_title" android:parentActivityName=".activities.ExplorerActivity" />
    </application>

</manifest>
